# ---------------------------------------------------------------------------
# CV Screener — environment configuration
#
# Copy to `.env` at the repo root and fill in the two required values:
#
#     cp .env.example .env
#
# Everything else has a working default. The whole stack runs on free tiers.
# Configuration is validated by zod at API boot: an invalid or inconsistent
# combination fails immediately with a list of every problem, rather than
# halfway through generating a corpus.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
#
# | Variable            | Required | Default                                            | Purpose                                    |
# | ------------------- | -------- | -------------------------------------------------- | ------------------------------------------ |
# | NODE_ENV            | No       | development                                        | development | test | production           |
# | PORT                | No       | 3001                                               | API listen port                            |
# | DATABASE_URL        | **Yes**  | —                                                  | Postgres connection string (see `pnpm db:up`) |
# | CV_STORAGE_DIR      | No       | ./apps/api/storage                                 | Where generated PDFs, portraits and profile JSON land |
# | NEXT_PUBLIC_API_URL | No       | http://localhost:3001                              | API origin the web app proxies to          |

NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cv_screener
CV_STORAGE_DIR=./apps/api/storage
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Text generation (CV content + grounded answers) ------------------------
#
# | Variable           | Required                    | Default          | Purpose                              |
# | ------------------ | --------------------------- | ---------------- | ------------------------------------ |
# | LLM_PROVIDER       | No                          | gemini           | gemini | openrouter                  |
# | GOOGLE_API_KEY     | **Yes** if provider=gemini  | —                | Free key: https://aistudio.google.com/apikey |
# | OPENROUTER_API_KEY | **Yes** if provider=openrouter | —             | Free key: https://openrouter.ai/settings/keys |
# | LLM_TEXT_MODEL     | No                          | per-provider     | Overrides the provider's default model |
#
# Provider defaults:
#   gemini     -> gemini-2.5-flash
#   openrouter -> deepseek/deepseek-chat-v3:free
#
# Free OpenRouter alternatives if one is rate-limited:
#   meta-llama/llama-3.3-70b-instruct:free
#   google/gemini-2.0-flash-exp:free

LLM_PROVIDER=gemini
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
# LLM_TEXT_MODEL=

# --- Embeddings -------------------------------------------------------------
#
# | Variable             | Required                   | Default              | Purpose                          |
# | -------------------- | -------------------------- | -------------------- | -------------------------------- |
# | EMBEDDING_PROVIDER   | No                         | local                | local | gemini                   |
# | EMBEDDING_MODEL      | No                         | per-provider         | Overrides the provider's default |
# | EMBEDDING_DIMENSIONS | No                         | per-provider         | MUST match the pgvector column   |
#
# `local` runs multilingual-e5-small (384 dims) in-process via fastembed:
# no API key, no quota, no network, and re-indexing is free — which is what
# makes it practical to iterate on the chunking strategy.
#
# Provider defaults:
#   local  -> multilingual-e5-small, 384 dims
#   gemini -> gemini-embedding-001, 1536 dims (truncated from 3072)
#
# WARNING: the pgvector column width is fixed by migration. Changing
# EMBEDDING_DIMENSIONS requires a new migration, not just an edit here.
# Ingestion asserts the embedder's width matches the schema at startup.

EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=
# EMBEDDING_DIMENSIONS=

# --- Portraits --------------------------------------------------------------
#
# | Variable           | Required                        | Default      | Purpose                    |
# | ------------------ | ------------------------------- | ------------ | -------------------------- |
# | PORTRAIT_PROVIDER  | No                              | pollinations | pollinations | huggingface | svg |
# | HUGGINGFACE_API_KEY| **Yes** if provider=huggingface | —            | Free key: https://huggingface.co/settings/tokens |
# | PORTRAIT_MODEL     | No                              | per-provider | Overrides the default model |
#
# `pollinations` needs no key at all. Whichever provider is configured, a
# deterministic local SVG avatar is the terminal fallback, so a slow or
# rate-limited image service can never fail a CV.

PORTRAIT_PROVIDER=pollinations
HUGGINGFACE_API_KEY=
# PORTRAIT_MODEL=

# --- Generation batching ----------------------------------------------------
#
# The corpus is generated in sequential batches: a batch runs in parallel, every
# member settles, the pipeline pauses, then the next batch starts. Batch size is
# the only parallelism dial — a separate concurrency setting would overlap with
# it and make neither predictable.
#
# Batching buys three things a plain parallelism cap does not:
#   * pacing — a delay between batches respects per-minute quotas, which a
#     concurrency limit alone does nothing about
#   * checkpoints — each batch is persisted before the next starts, so a
#     mid-run failure loses at most one batch
#   * adaptive backoff — a rate-limited batch multiplies the delay for the ones
#     that follow, so a run degrades instead of failing
#
# Re-running is always safe: completed CVs are skipped by checksum, so a failed
# run resumes by clicking Generate again.
#
# | Variable                        | Required | Default | Purpose                                          |
# | ------------------------------- | -------- | ------- | ------------------------------------------------ |
# | GENERATION_BATCH_SIZE           | No       | 5       | CVs per batch, and the parallelism within one     |
# | GENERATION_BATCH_DELAY_MS       | No       | 1500    | Pause between batches                             |
# | GENERATION_BATCH_BACKOFF_FACTOR | No       | 2       | Delay multiplier after a rate-limited batch       |
# | GENERATION_MAX_BATCH_DELAY_MS   | No       | 60000   | Ceiling on the backed-off delay                   |
# | CORPUS_DEFAULT_SIZE             | No       | 30      | Target corpus size when the UI button is clicked   |
# | CORPUS_SEED                     | No       | 42      | Seeds the persona plan; same seed, same corpus     |
#
# 30 CVs at the defaults is 6 batches — roughly 8s of deliberate pausing across
# the whole run, which is noise next to the LLM calls themselves.

GENERATION_BATCH_SIZE=5
GENERATION_BATCH_DELAY_MS=1500
GENERATION_BATCH_BACKOFF_FACTOR=2
GENERATION_MAX_BATCH_DELAY_MS=60000
CORPUS_DEFAULT_SIZE=30
CORPUS_SEED=42

# --- Observability (optional) -----------------------------------------------
#
# | Variable             | Required | Default                   | Purpose                    |
# | -------------------- | -------- | ------------------------- | -------------------------- |
# | LANGFUSE_PUBLIC_KEY  | No       | —                         | Free tier: https://cloud.langfuse.com |
# | LANGFUSE_SECRET_KEY  | No       | —                         | Both keys or neither       |
# | LANGFUSE_BASE_URL    | No       | https://cloud.langfuse.com| Self-hosted instance       |
#
# Leave blank to disable tracing entirely — the app uses a no-op implementation
# and runs normally, which is also how CI runs it.

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=

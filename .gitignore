# Dependencies
node_modules/
.pnpm-store/

# Next.js
.next/
out/

# Turborepo
.turbo/

# Build output
dist/
build/

# Generated corpus: PDFs, portraits and profile JSON. Regenerate with the UI
# button or `pnpm generate:cvs` — these are outputs, not sources.
# The directory negation is load-bearing: without it git never descends into
# the subdirectories, so the .gitkeep negation below can never match.
apps/api/storage/**/*
!apps/api/storage/**/
!apps/api/storage/**/.gitkeep

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Debug logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Testing / coverage
coverage/

# IDE
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# OS
.DS_Store
Thumbs.db

# Vercel
.vercel/

# Misc
*.log